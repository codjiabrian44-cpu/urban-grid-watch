---
import type { Lang } from '../../utils/format';

interface Props {
  lang: Lang;
  caption: string;
}

const { lang, caption } = Astro.props;

const labels =
  lang === 'fr'
    ? {
        title: 'Cartographie systémique — 4 axes couplés',
        badge: 'Dépendances croisées',
        ariaTitle: 'Schéma des quatre familles de vulnérabilités et de leurs dépendances croisées',
        q1: '01 Technique',
        q1Sub: 'Cloisonnement IT/OT',
        q2: '02 Humaine',
        q2Sub: 'Pression & hameçonnage',
        q3: '03 Physique',
        q3Sub: 'Armoires & supports USB',
        q4: '04 Organisationnelle',
        q4Sub: 'Tiers & inventaire',
        centerLine1: 'Surface',
        centerLine2: 'systémique',
        centerSingle: 'Surface systémique',
      }
    : {
        title: 'Systemic Cartography — 4 Coupled Axes',
        badge: 'Cross-dependencies',
        ariaTitle: 'Four vulnerability families and cross-domain dependency diagram',
        q1: '01 Technical',
        q1Sub: 'IT/OT segmentation',
        q2: '02 Human',
        q2Sub: 'Workload & phishing',
        q3: '03 Physical',
        q3Sub: 'Cabinets & USB media',
        q4: '04 Organizational',
        q4Sub: 'Vendors & inventory',
        centerLine1: 'Systemic',
        centerLine2: 'Surface',
        centerSingle: 'Systemic Surface',
      };
---

<figure class="schematic-frame">
  <div class="schematic-head">
    <span class="schematic-title">{labels.title}</span>
    <span class="schematic-status schematic-status-petrol">
      <span class="status-dot status-dot-petrol" aria-hidden="true"></span>
      <span>{labels.badge}</span>
    </span>
  </div>

  <!-- Desktop 4-Quadrant Systemic Cartography (viewBox 500x340; all <text> >= 11px -> >= 11.7px effective) -->
  <svg
    class="schematic-svg diagram-svg-desktop"
    viewBox="0 0 500 340"
    role="img"
    aria-labelledby="cm-d-title cm-d-desc"
  >
    <title id="cm-d-title">{labels.ariaTitle}</title>
    <desc id="cm-d-desc">{caption}</desc>

    <defs>
      <pattern id="cm-d-dot-grid" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="9" cy="9" r="0.8" fill="#3A2F27" />
      </pattern>
      <linearGradient id="cm-d-plate-bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1A1512" />
        <stop offset="100%" stop-color="#231D19" />
      </linearGradient>
      <radialGradient id="cm-d-hub-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#1F4A4D" stop-opacity="0.7" />
        <stop offset="100%" stop-color="#1F4A4D" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="cm-d-signal-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F26357" stop-opacity="0.52" />
        <stop offset="100%" stop-color="#F26357" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="8" y="8" width="484" height="324" fill="url(#cm-d-plate-bg)" stroke="#3A2F27" stroke-width="1" />
    <rect x="8" y="8" width="484" height="324" fill="url(#cm-d-dot-grid)" />

    <line x1="250" y1="18" x2="250" y2="322" stroke="#3A2F27" stroke-width="1" />
    <line x1="18" y1="170" x2="482" y2="170" stroke="#3A2F27" stroke-width="1" />
    <circle cx="250" cy="170" r="142" fill="none" stroke="#3A2F27" stroke-width="1" stroke-dasharray="2 5" />
    <circle cx="250" cy="170" r="94" fill="none" stroke="#CFE3E0" stroke-opacity="0.35" stroke-width="1.1" stroke-dasharray="5 4" />
    <circle cx="250" cy="170" r="72" fill="url(#cm-d-hub-glow)" />

    <g fill="none">
      <line x1="122" y1="84" x2="250" y2="170" stroke="#CFE3E0" stroke-opacity="0.65" stroke-width="1.6" />
      <line x1="378" y1="84" x2="250" y2="170" stroke="#B8A990" stroke-opacity="0.65" stroke-width="1.4" />
      <line x1="122" y1="256" x2="250" y2="170" stroke="#B8A990" stroke-opacity="0.65" stroke-width="1.4" />
      <line x1="378" y1="256" x2="250" y2="170" stroke="#CFE3E0" stroke-opacity="0.65" stroke-width="1.6" />

      <path d="M 122 84 Q 250 40 378 84" stroke="#B8A990" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="3 3" />
      <path d="M 122 256 Q 250 300 378 256" stroke="#B8A990" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="3 3" />
      <path d="M 122 84 Q 62 170 122 256" stroke="#B8A990" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="3 3" />
      <path d="M 378 84 Q 438 170 378 256" stroke="#B8A990" stroke-opacity="0.4" stroke-width="1" stroke-dasharray="3 3" />
    </g>

    <g transform="translate(122, 84)">
      <rect x="-88" y="-44" width="176" height="90" fill="#1F4A4D" stroke="#CFE3E0" stroke-width="1.35" />
      <circle cx="42" cy="-14" r="22" fill="url(#cm-d-signal-glow)" />
      <circle cx="-42" cy="-14" r="4.5" fill="#CFE3E0" />
      <circle cx="-12" cy="-20" r="4.5" fill="#CFE3E0" />
      <circle cx="16" cy="-12" r="4.5" fill="#EDE4D3" />
      <circle cx="42" cy="-14" r="6.5" fill="#F26357" />
      <circle cx="42" cy="-14" r="12" fill="none" stroke="#F26357" stroke-dasharray="3 2" stroke-width="1.3" />
      <text x="0" y="16" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="12" font-weight="500">
        {labels.q1}
      </text>
      <text x="0" y="34" text-anchor="middle" fill="#CFE3E0" font-family="'IBM Plex Sans', sans-serif" font-size="11">
        {labels.q1Sub}
      </text>
    </g>

    <g transform="translate(378, 84)">
      <rect x="-88" y="-44" width="176" height="90" fill="#231D19" stroke="#B8A990" stroke-width="1.3" />
      <line x1="-88" y1="-44" x2="88" y2="-44" stroke="#EDE4D3" stroke-width="2.5" />
      <circle cx="-36" cy="-14" r="4.5" fill="#EDE4D3" />
      <circle cx="0" cy="-20" r="4.5" fill="#B8A990" />
      <circle cx="36" cy="-12" r="4.5" fill="#EDE4D3" />
      <text x="0" y="16" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="12" font-weight="500">
        {labels.q2}
      </text>
      <text x="0" y="34" text-anchor="middle" fill="#B8A990" font-family="'IBM Plex Sans', sans-serif" font-size="11">
        {labels.q2Sub}
      </text>
    </g>

    <g transform="translate(122, 256)">
      <rect x="-88" y="-44" width="176" height="90" fill="#231D19" stroke="#B8A990" stroke-width="1.3" />
      <line x1="-88" y1="-44" x2="88" y2="-44" stroke="#CFE3E0" stroke-width="2.5" />
      <circle cx="-36" cy="-14" r="4.5" fill="#CFE3E0" />
      <circle cx="0" cy="-20" r="4.5" fill="#B8A990" />
      <circle cx="36" cy="-12" r="4.5" fill="#CFE3E0" />
      <text x="0" y="16" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="12" font-weight="500">
        {labels.q3}
      </text>
      <text x="0" y="34" text-anchor="middle" fill="#B8A990" font-family="'IBM Plex Sans', sans-serif" font-size="11">
        {labels.q3Sub}
      </text>
    </g>

    <g transform="translate(378, 256)">
      <rect x="-88" y="-44" width="176" height="90" fill="#1F4A4D" stroke="#CFE3E0" stroke-width="1.35" />
      <circle cx="-36" cy="-14" r="4.5" fill="#CFE3E0" />
      <circle cx="0" cy="-20" r="4.5" fill="#EDE4D3" />
      <circle cx="36" cy="-12" r="4.5" fill="#CFE3E0" />
      <text x="0" y="16" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="12" font-weight="500">
        {labels.q4}
      </text>
      <text x="0" y="34" text-anchor="middle" fill="#CFE3E0" font-family="'IBM Plex Sans', sans-serif" font-size="11">
        {labels.q4Sub}
      </text>
    </g>

    <circle cx="250" cy="170" r="46" fill="#1A1512" stroke="#EDE4D3" stroke-width="1.5" />
    <circle cx="250" cy="170" r="39" fill="#1F4A4D" stroke="#CFE3E0" stroke-opacity="0.6" stroke-width="1" />
    <text x="250" y="166" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Sans', sans-serif" font-size="11" font-weight="600">
      <tspan x="250" dy="0">{labels.centerLine1}</tspan>
      <tspan x="250" dy="14">{labels.centerLine2}</tspan>
    </text>
  </svg>

  <!-- Mobile Stacked 4-Axis Systemic Cartography (viewBox 340x488; all <text> >= 12.5 -> >= 11.7px effective) -->
  <svg
    class="schematic-svg diagram-svg-mobile"
    viewBox="0 0 340 488"
    role="img"
    aria-labelledby="cm-m-title cm-m-desc"
    aria-hidden="true"
  >
    <title id="cm-m-title">{labels.ariaTitle}</title>
    <desc id="cm-m-desc">{caption}</desc>

    <defs>
      <pattern id="cm-m-dot-grid" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="9" cy="9" r="0.8" fill="#3A2F27" />
      </pattern>
      <linearGradient id="cm-m-plate-bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1A1512" />
        <stop offset="100%" stop-color="#231D19" />
      </linearGradient>
      <radialGradient id="cm-m-hub-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#1F4A4D" stop-opacity="0.72" />
        <stop offset="100%" stop-color="#1F4A4D" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="cm-m-signal-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F26357" stop-opacity="0.52" />
        <stop offset="100%" stop-color="#F26357" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="6" y="6" width="328" height="476" fill="url(#cm-m-plate-bg)" stroke="#3A2F27" stroke-width="1" />
    <rect x="6" y="6" width="328" height="476" fill="url(#cm-m-dot-grid)" />

    <!-- Central Coupling Spine & Orbital Arc -->
    <line x1="170" y1="20" x2="170" y2="468" stroke="#3A2F27" stroke-width="1.2" />
    <circle cx="170" cy="244" r="110" fill="none" stroke="#3A2F27" stroke-width="1" stroke-dasharray="3 4" />
    <circle cx="170" cy="244" r="68" fill="url(#cm-m-hub-glow)" />

    <!-- Axis 1: Technical (Petrol + 1 Signal indicator) -->
    <g transform="translate(18, 20)">
      <rect width="304" height="76" fill="#1F4A4D" stroke="#CFE3E0" stroke-width="1.35" />
      <circle cx="272" cy="38" r="20" fill="url(#cm-m-signal-glow)" />
      <circle cx="272" cy="38" r="6" fill="#F26357" />
      <circle cx="272" cy="38" r="12" fill="none" stroke="#F26357" stroke-dasharray="3 2" stroke-width="1.3" />
      <text x="16" y="32" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="13.5" font-weight="500">
        {labels.q1}
      </text>
      <text x="16" y="55" fill="#CFE3E0" font-family="'IBM Plex Sans', sans-serif" font-size="13">
        {labels.q1Sub}
      </text>
    </g>

    <!-- Axis 2: Human -->
    <g transform="translate(18, 108)">
      <rect width="304" height="76" fill="#231D19" stroke="#B8A990" stroke-width="1.3" />
      <line x1="0" y1="0" x2="304" y2="0" stroke="#EDE4D3" stroke-width="2.5" />
      <circle cx="272" cy="38" r="5" fill="#EDE4D3" />
      <text x="16" y="32" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="13.5" font-weight="500">
        {labels.q2}
      </text>
      <text x="16" y="55" fill="#B8A990" font-family="'IBM Plex Sans', sans-serif" font-size="13">
        {labels.q2Sub}
      </text>
    </g>

    <!-- Central Systemic Coupling Hub -->
    <line x1="170" y1="184" x2="170" y2="212" stroke="#CFE3E0" stroke-width="1.6" />
    <line x1="170" y1="276" x2="170" y2="304" stroke="#CFE3E0" stroke-width="1.6" />
    <rect x="64" y="212" width="212" height="64" rx="2" fill="#1A1512" stroke="#EDE4D3" stroke-width="1.4" />
    <rect x="70" y="218" width="200" height="52" fill="#1F4A4D" stroke="#CFE3E0" stroke-opacity="0.55" stroke-width="1" />
    <text x="170" y="249" text-anchor="middle" fill="#EDE4D3" font-family="'IBM Plex Sans', sans-serif" font-size="14" font-weight="600">
      {labels.centerSingle}
    </text>

    <!-- Axis 3: Physical -->
    <g transform="translate(18, 304)">
      <rect width="304" height="76" fill="#231D19" stroke="#B8A990" stroke-width="1.3" />
      <line x1="0" y1="0" x2="304" y2="0" stroke="#CFE3E0" stroke-width="2.5" />
      <circle cx="272" cy="38" r="5" fill="#CFE3E0" />
      <text x="16" y="32" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="13.5" font-weight="500">
        {labels.q3}
      </text>
      <text x="16" y="55" fill="#B8A990" font-family="'IBM Plex Sans', sans-serif" font-size="13">
        {labels.q3Sub}
      </text>
    </g>

    <!-- Axis 4: Organizational -->
    <g transform="translate(18, 392)">
      <rect width="304" height="76" fill="#1F4A4D" stroke="#CFE3E0" stroke-width="1.35" />
      <circle cx="272" cy="38" r="5" fill="#EDE4D3" />
      <text x="16" y="32" fill="#EDE4D3" font-family="'IBM Plex Mono', monospace" font-size="13.5" font-weight="500">
        {labels.q4}
      </text>
      <text x="16" y="55" fill="#CFE3E0" font-family="'IBM Plex Sans', sans-serif" font-size="13">
        {labels.q4Sub}
      </text>
    </g>
  </svg>

  <figcaption class="schematic-caption">{caption}</figcaption>
</figure>

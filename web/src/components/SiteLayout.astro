---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/diagrams.css';

import {
  ROUTES,
  UI_COPY,
  getNeighbors,
  getRouteFor,
  type PageKey,
} from '../data/site';
import type { Lang } from '../utils/format';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
}

const { lang, pageKey, title, description } = Astro.props;
const ui = UI_COPY[lang];
const currentHref = getRouteFor(pageKey, lang);
const frHref = getRouteFor(pageKey, 'fr');
const enHref = getRouteFor(pageKey, 'en');
const toHreflangUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).toString() : path);
const counterpartLang: Lang = lang === 'fr' ? 'en' : 'fr';
const counterpartHref = getRouteFor(pageKey, counterpartLang);
const { prev, next } = getNeighbors(pageKey, lang);
const sourcesHref = getRouteFor('sources', lang);
const homeHref = getRouteFor('home', lang);
---

<!doctype html>
<html lang={lang} data-reading-mode="deep">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect x='1' y='1' width='14' height='14' fill='%231F4A4D' stroke='%23CFE3E0' stroke-width='2'/%3E%3C/svg%3E"
    />
    <link rel="canonical" href={toHreflangUrl(currentHref)} />
    <link rel="alternate" hreflang="fr" href={toHreflangUrl(frHref)} />
    <link rel="alternate" hreflang="en" href={toHreflangUrl(enHref)} />
    <link rel="alternate" hreflang="x-default" href={toHreflangUrl(frHref)} />
    <script is:inline>
      (function () {
        try {
          if (/^#src-\d+$/i.test(window.location.hash || '')) {
            document.documentElement.setAttribute('data-reading-mode', 'deep');
            return;
          }
          var saved = localStorage.getItem('ugw_reading_depth');
          if (saved === 'quick' || saved === 'deep') {
            document.documentElement.setAttribute('data-reading-mode', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipLink}</a>

    <header class="site-header">
      <div class="utility-bar">
        <div class="wrap utility-inner">
          <div class="utility-subtitle">{ui.siteSubtitle}</div>
          <div class="utility-controls">
            <div
              class="depth-switcher"
              role="group"
              aria-label={ui.depthLabel}
            >
              <button
                type="button"
                class="depth-btn"
                data-depth-choice="quick"
                aria-pressed="false"
              >
                {ui.depthQuick}
              </button>
              <button
                type="button"
                class="depth-btn"
                data-depth-choice="deep"
                aria-pressed="true"
              >
                {ui.depthDeep}
              </button>
            </div>

            <nav class="lang-switch" aria-label={ui.langSwitchLabel}>
              {lang === 'fr' ? (
                <>
                  <a class="lang-item is-active" href={currentHref} aria-current="page" lang="fr" hreflang="fr">
                    FR
                  </a>
                  <a class="lang-item" href={counterpartHref} lang="en" hreflang="en">
                    EN
                  </a>
                </>
              ) : (
                <>
                  <a class="lang-item" href={counterpartHref} lang="fr" hreflang="fr">
                    FR
                  </a>
                  <a class="lang-item is-active" href={currentHref} aria-current="page" lang="en" hreflang="en">
                    EN
                  </a>
                </>
              )}
            </nav>
          </div>
        </div>
      </div>

      <div class="wrap masthead-inner">
        <a class="site-brand" href={homeHref}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-title">{ui.siteTitle}</span>
        </a>

        <nav class="primary-nav" aria-label={ui.navAriaLabel}>
          {ROUTES.map((route) => {
            const href = getRouteFor(route.key, lang);
            const isCurrent = route.key === pageKey;
            return (
              <a
                class="nav-link"
                href={href}
                aria-current={isCurrent ? 'page' : undefined}
              >
                <span class="nav-index">{route.indexNum}</span>
                <span>{route.navLabel[lang]}</span>
              </a>
            );
          })}
        </nav>

        <button
          type="button"
          class="mobile-menu-toggle"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          data-open-label={ui.menuOpenLabel}
          data-close-label={ui.menuCloseLabel}
        >
          {ui.menuOpenLabel}
        </button>
      </div>

      <nav
        id="mobile-nav-drawer"
        class="mobile-nav-drawer"
        aria-label={ui.navAriaLabel}
        aria-hidden="true"
      >
        <ul class="mobile-nav-list">
          {ROUTES.map((route) => {
            const href = getRouteFor(route.key, lang);
            const isCurrent = route.key === pageKey;
            return (
              <li>
                <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                  <span class="nav-index">{route.indexNum}</span>
                  <span>{route.navLabel[lang]}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main id="main-content" data-current-route={currentHref}>
      <slot />

      <div class="wrap">
        <aside class="quick-mode-notice" aria-live="polite">
          <div>
            <strong>{ui.quickReadContinueTitle}</strong>
            <p class="triptych-detail">{ui.quickReadContinueHint}</p>
          </div>
          <button type="button" class="btn-inline" data-set-depth="deep">
            {ui.expandDeepDive}
          </button>
        </aside>
      </div>
    </main>

    {(prev || next) && (
      <nav class="pagination-bar wrap" aria-label={lang === 'fr' ? 'Pagination du dossier' : 'Dossier pagination'}>
        <div>
          {prev && (
            <a class="page-step-link" href={prev.href}>
              <span class="page-step-dir">{ui.prevPage}</span>
              <span class="page-step-title">{prev.title}</span>
            </a>
          )}
        </div>
        <div>
          {next && (
            <a class="page-step-link" href={next.href}>
              <span class="page-step-dir">{ui.nextPage}</span>
              <span class="page-step-title">{next.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p class="footer-safety">{ui.safetyMention}</p>
        <div class="footer-links">
          <a href={sourcesHref}>{ui.sourcesLinkLabel}</a>
          <a href={counterpartHref} lang={counterpartLang} hreflang={counterpartLang}>
            {ui.otherLangLabel}
          </a>
        </div>
      </div>
    </footer>

    <script src="../scripts/motion.ts"></script>
  </body>
</html>
